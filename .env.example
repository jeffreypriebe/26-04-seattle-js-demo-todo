# JWT secret for signing auth tokens. Change this in production.
JWT_SECRET=dev-secret-change-in-production
# API server port (default 3001 — port 3000 is reserved by beads-ui)
PORT=3001
# Frontend base URL used to build invite links (e.g. GET /teams/:id/invite).
# Set this so invite_link points to the React dev server instead of the API.
APP_BASE_URL=http://localhost:5173
